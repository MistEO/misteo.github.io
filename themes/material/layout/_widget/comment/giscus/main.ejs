<% if (site.data.legacy_comments && page.date) { %>
    <% var legacyKey = page.date.clone().locale('en').format('ddd MMM DD YYYY HH:mm:ss [GMT]ZZ'); %>
    <% var legacyItems = site.data.legacy_comments[legacyKey] || []; %>
    <% if (legacyItems.length) { %>
        <div class="legacy-comments">
            <div class="legacy-comments-title">以前的评论</div>
            <% legacyItems.forEach(function(item) { %>
                <div class="legacy-comment">
                    <div class="legacy-comment-meta">
                        <a href="https://github.com/<%= item.author %>" target="_blank" rel="nofollow"><%= item.author %></a>
                        <span><%= item.createdAt %></span>
                    </div>
                    <div class="legacy-comment-body"><%- item.html %></div>
                </div>
            <% }) %>
        </div>
    <% } %>
<% } %>

<div class="giscus-wrap">
<script src="https://giscus.app/client.js"
        data-repo="<%= theme.comment.giscus_repo %>"
        data-repo-id="<%= theme.comment.giscus_repo_id %>"
        data-category="<%= theme.comment.giscus_category %>"
        data-category-id="<%= theme.comment.giscus_category_id %>"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="light"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
        async>
</script>
</div>
